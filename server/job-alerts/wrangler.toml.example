# Copy to wrangler.toml, create the KV namespace, then:  npx wrangler deploy
#   npx wrangler kv namespace create STATE        (paste the id below)
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put ALERT_EMAIL_TO
#   npx wrangler secret put NTFY_TOPIC            (optional phone push)
name = "job-alerts"
main = "worker.js"
compatibility_date = "2026-01-01"

[triggers]
crons = ["* * * * *"]

[[kv_namespaces]]
binding = "STATE"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
